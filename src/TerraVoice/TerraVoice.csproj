<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../tModLoader.targets" Condition="Exists('../tModLoader.targets')" />
    <Import Project="../../../tModLoader.targets" Condition="!Exists('../tModLoader.targets')" />

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
        <Nullable>enable</Nullable>
        <RootNamespace>TerraVoice</RootNamespace>

    </PropertyGroup>

    <ItemGroup>
      <Reference Include="P-OpusCore">
        <HintPath>lib\P-OpusCore.dll</HintPath>
      </Reference>
    </ItemGroup>

    <Target Name="BuildMod" AfterTargets="Build" Condition="'$(BuildMod)' == 'true'">
      <PropertyGroup>
        <NativeBuildPrefix Condition="$([MSBuild]::IsOSPlatform('OSX'))">DYLD_LIBRARY_PATH="$(tMLSteamPath)Libraries/Native/OSX" </NativeBuildPrefix>
      </PropertyGroup>
      <Exec Command="$(NativeBuildPrefix)dotnet $(tMLServerPath) -build &quot;$(ProjectDir)&quot; -eac &quot;$(TargetPath)&quot; -define &quot;$(DefineConstants)&quot; -unsafe $(AllowUnsafeBlocks) $(ExtraBuildModFlags)" WorkingDirectory="$(tMLSteamPath)" />
    </Target>

</Project>
